# Optional settings for the port scanner. Copy this file to ".env" in the project folder
# and fill in what you use; ".env" is gitignored, never commit it.
# A real environment variable with the same name wins over the line here.
# (Fallback: tools/Port_scan/api_keys.txt, see api_keys.example.txt.)

# OpenRouter: optional AI explanation, asked before anything is sent (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter model (optional; default deepseek/deepseek-chat:free)
OPENROUTER_MODEL=

# AbuseIPDB: IP reputation check, asked before anything is sent (https://www.abuseipdb.com/api)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# NVD: CVE lookups work without a key, but are limited to about one every 6 seconds
# (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# Settings starting with TOOLKIT_ (for example TOOLKIT_LOG_LEVEL) are read from the
# environment only, not from this file.
